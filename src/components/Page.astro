---
import Base from '../layouts/Base.astro';
import ThemeIcon from '../assets/theme.svg';
import GitHubIcon from '../assets/github.svg';
import { copy, type Lang } from '../i18n/copy';
import { languages, pagePath } from '../lib/languages.mjs';
import { REPO, RELEASES } from '../lib/releases.mjs';
import m from '../data/measurements.json';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const d = copy(lang);
const base = '/spk-ocular/';
const external = { target: '_blank', rel: 'noopener noreferrer' };
const about = 'https://sipaha.github.io/about/';
const shots = ['workloads', 'logs', 'helm', 'docker'];
const shotURL = (name: string) => `${base}media/${name}-${lang === 'ru' ? 'ru' : 'en'}.webp?v=1.7.0`;
const navIDs = ['features', 'interface', 'free'];
const fmt = (value: number, digits = 0) => new Intl.NumberFormat(lang, {maximumFractionDigits:digits, minimumFractionDigits:digits}).format(value);
const fill = (text: string, values: Record<string,string>) => text.replace(/\{(\w+)\}/g, (match,key) => values[key] ?? match);
---
<Base lang={lang} title={d.title} description={d.description}>
  <a href="#main" class="skip">{d.skip}</a>
  <header class="header">
    <div class="container header-inner">
      <a class="brand" href={pagePath(lang, base)} aria-label="SPK Ocular">
        <img src={base + 'icon.svg'} width="32" height="32" alt="" />
        <span>SPK <strong>Ocular</strong></span>
      </a>
      <nav aria-label={d.menu} class="desktop-nav">
        {navIDs.map((id,i) => <a href={'#' + id}>{id === 'free' ? d.freeNav : d.nav[i]}</a>)}
        <a class="header-support" href={about+'#support'} {...external}>{d.supportNav}</a>
        <a class="github-link" href={REPO} {...external} aria-label="GitHub" title="GitHub"><GitHubIcon width="20" height="20" aria-hidden="true" /></a>
      </nav>
      <div class="header-actions">
        <details class="language-menu"><summary class="language" aria-label={d.languageLabel} title={d.languageLabel}><span class="language-label">{languages.find(l => l.code === lang)?.short}</span><svg class="language-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m3 4.5 3 3 3-3" /></svg></summary><nav class="language-options" aria-label={d.languageLabel}>{languages.map(l => <a href={pagePath(l.code, base)} lang={l.code} hreflang={l.code} data-language={l.code} aria-current={l.code === lang ? 'page' : undefined}>{l.name}</a>)}</nav></details>
        <button type="button" class="theme-toggle" aria-label={d.theme} title={d.theme} hidden><ThemeIcon width="20" height="20" aria-hidden="true" /></button>
        <a class="button compact" href="#downloads" aria-label={d.headerDownload} data-download-label={JSON.stringify({download:d.download,downloadCompactVersion:d.downloadCompactVersion,downloadFormatFor:d.downloadFormatFor,choose:d.headerDownload,chooseCompact:d.headerDownload,chooseFor:d.headerDownload})}><span data-download-text>{d.headerDownload}</span><span class="compact-download-text" aria-hidden="true">{d.headerDownload}</span><span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <nav class="mobile-nav container" aria-label={d.menu}>
      {navIDs.map((id,i) => <a href={'#' + id}>{id === 'free' ? d.freeNav : d.nav[i]}</a>)}
      <a class="header-support" href={about+'#support'} {...external}>{d.supportNav}</a>
      <a class="github-link" href={REPO} {...external} aria-label="GitHub" title="GitHub"><GitHubIcon width="20" height="20" aria-hidden="true" /></a>
    </nav>
  </header>
  <main id="main">
    <section class="hero container">
      <p class="eyebrow">{d.eyebrow}</p>
      <div class="hero-heading">
        <h1>{d.hero[0]}<span>{d.hero[1]}</span></h1>
        <div class="hero-side"><p class="lead">{d.lead}<span class="hero-setup"><strong>{d.setupTitle}</strong><span>{d.setupText}</span></span></p><div class="hero-actions"><div class="download-action"><a class="button" href="#downloads" aria-label={d.chooseDownload} data-download-label={JSON.stringify({download:d.download,downloadCompactVersion:d.downloadCompactVersion,downloadFormatFor:d.downloadFormatFor,choose:d.chooseDownload,chooseCompact:d.chooseCompact,chooseFor:d.chooseDownloadFor})}><span data-download-text>{d.chooseDownload}</span><span aria-hidden="true">↓</span></a><a class="all-releases" href={RELEASES} {...external}>{d.allReleases}<span aria-hidden="true">↗</span></a></div><a class="text-link" href="#interface">{d.explore}<span aria-hidden="true">↗</span></a></div></div>
      </div>
      <div class="hero-meta"><a href="#free">{d.freeShort}<span aria-hidden="true">↗</span></a><span>{d.platforms}</span></div>
      <figure class="hero-visual">
        <div class="visual-caption"><span><span class="status-dot" aria-hidden="true"></span>SPK Ocular</span><span>{d.heroCaption}</span></div>
        <a data-image-preview href={shotURL('logs')} aria-label={d.fullImage}><img src={shotURL('logs')} width="1440" height="900" alt={d.galleryAlts[1]} fetchpriority="high" decoding="async" /></a>
        <figcaption>{d.demo}</figcaption>
      </figure>
    </section>
    <div class="container facts">{d.facts.map(([title,text]) => <div><strong>{title}</strong><span>{text}</span></div>)}</div>
    <section class="container section local-section" aria-labelledby="cluster-care">
      <div><h2 id="cluster-care">{d.clusterTitle}</h2><p>{d.clusterText}</p></div>
      <div class="local-points">{d.clusterPoints.map(([title,text])=><article><h3>{title}</h3><p>{text}</p></article>)}</div>
    </section>
    <section id="measurements" class="container section measurement-section" aria-labelledby="measurement-title">
      <div class="section-head"><h2 id="measurement-title">{fill(d.measurementTitle,{resources:fmt(m.resources,0),memory:fmt(m.sampledPeakPSSMiB,0)})}</h2><p>{fill(d.measurementText,{resources:fmt(m.resources,0)})}</p></div>
      <dl class="measurement-metrics">
        <div><dt>{d.measurementLoad}</dt><dd>{fmt(m.coldMedianSeconds,1)} <span>{d.measurementSeconds}</span></dd></div>
        <div><dt>{d.measurementResources}</dt><dd>{fmt(m.resources,0)}</dd></div>
        <div><dt>{d.measurementRate}</dt><dd>{fmt(m.readQPS,0)}</dd></div>
        <div><dt>{d.measurementMemory}</dt><dd>{fmt(m.sampledPeakPSSMiB,0)} <span>{d.measurementMiB}</span></dd></div>
      </dl>
      <p class="measurement-note">{fill(d.measurementNote,{version:m.version,runs:fmt(m.validCurrentSessions,0)})}</p>
      <details class="measurement-conditions"><summary>{d.measurementConditions}</summary><div>
        <p>{d.measurementBudget}</p><p>{fill(d.measurementSetup,{version:m.version})}</p><p>{fill(d.measurementBoundary,{runs:fmt(m.validCurrentSessions,0)})}</p>
        <p>{fill(d.measurementMethod,{peakInterval:fmt(m.peakSamplingSeconds,1)})}</p>
        <p><time datetime={m.dateISO}>{m.dateDisplay}</time> · <a href={REPO+'/blob/master/docs/performance.md'} {...external}>{d.measurementSummary} ↗</a> · <a href={REPO+'/blob/master/docs/performance-data/2026-10-16-memory.csv'} {...external}>{d.measurementRaw} ↗</a></p>
      </div></details>
    </section>
    <section id="features" class="container section">
      <div class="section-head"><h2>{d.overview}</h2><p>{d.overviewText}</p></div>
      <div class="workflows">
        {d.workflows.map((flow,i)=><article class:list={['workflow', {reverse:i===1}]} id={flow.image}>
          <div class="workflow-copy"><p class="eyebrow">{flow.label}</p><h3>{flow.title}</h3><p>{flow.text}</p>{flow.image==='logs'&&<p>{d.logHistoryText}</p>}<ul>{flow.points.map(point=><li>{point}</li>)}</ul></div>
          <figure class="workflow-image"><a data-image-preview href={shotURL(flow.image)} aria-label={d.fullImage}><img src={shotURL(flow.image)} width="1440" height="900" alt={flow.alt} loading="lazy" decoding="async" /></a><figcaption>{flow.image==='helm'?d.syntheticDemo:d.demo}</figcaption></figure>
        </article>)}
        <article class="workflow reverse" id="container-files">
          <div class="workflow-copy"><p class="eyebrow">{d.filesLabel}</p><h3>{d.filesTitle}</h3><p>{d.filesText}</p><ul>{d.filesPoints.map(point=><li>{point}</li>)}</ul><p>{d.filesBoundary}</p></div>
          <figure class="workflow-image"><a data-image-preview href={shotURL('files')} aria-label={d.fullImage}><img src={shotURL('files')} width="1440" height="900" alt={d.filesAlt} loading="lazy" decoding="async" /></a><figcaption>{d.filesCaption}</figcaption></figure>
        </article>
      </div>
      <div class="section-head investigation-head"><h3>{d.investigationTitle}</h3></div>
      <div class="workflows">{d.investigation.map((feature,i)=><article class:list={['workflow',{reverse:i%2===1}]} id={feature.image}>
        <div class="workflow-copy"><h3>{feature.title}</h3><p>{feature.text}</p></div>
        <figure class="workflow-image"><a data-image-preview href={shotURL(feature.image)} aria-label={d.fullImage}><img src={shotURL(feature.image)} width="1440" height="900" alt={feature.alt} loading="lazy" decoding="async" /></a><figcaption>{feature.image === 'security' ? d.securityDemo : d.demo}</figcaption></figure>
      </article>)}</div>
      <div class="tool-section"><h3>{d.toolsTitle}</h3><div class="tool-grid">{d.tools.map(([title,text],i)=><article><span class="tool-index" aria-hidden="true">0{i+1}</span><div><h4>{title}</h4><p>{text}</p></div></article>)}</div></div>
    </section>
    <section class="agent-section section" id="agents"><div class="container agent-grid">
      <div><p class="eyebrow">{d.agentLabel}</p><h2>{d.agentTitle}</h2><p class="agent-lead">{d.agentText}</p></div>
      <div><ol class="agent-steps">{d.agentSteps.map(([title,text])=><li><h3>{title}</h3><p>{text}</p></li>)}</ol><p class="agent-boundary">{d.agentBoundary}</p></div>
    </div></section>
    <section id="interface" class="section gallery-section"><div class="container">
      <div class="section-head"><h2>{d.gallery}</h2><p>{d.galleryText}</p>{d.screenshotNote && <p class="screenshot-note">{d.screenshotNote}</p>}</div>
      <div class="gallery-tabs" role="tablist" aria-label={d.nav[1]} hidden>{d.galleryTabs.map((title,i)=><button type="button" role="tab" id={'tab-'+i} aria-controls={'shot-'+i} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}>{title}</button>)}</div>
      <div class="gallery">{shots.map((shot,i)=><figure id={'shot-'+i} class="gallery-panel" data-gallery-panel>
        <a data-image-preview href={shotURL(shot)} aria-label={d.fullImage}><img src={shotURL(shot)} width="1440" height="900" alt={d.galleryAlts[i]} loading="lazy" decoding="async" /></a>
        <figcaption><span>{d.galleryCaptions[i]} · {shot==='helm'?d.syntheticDemo:shot==='docker'?d.filesCaption:d.demo}</span><a data-image-preview href={shotURL(shot)}>{d.fullImage} ↗</a></figcaption>
      </figure>)}</div>
    </div></section>
    <section class="container section local-section">
      <div><p class="eyebrow">{d.localLabel}</p><h2>{d.localTitle}</h2><p>{d.localText}</p><a class="text-link" href={REPO} {...external}>{d.source}<span aria-hidden="true">↗</span></a></div>
      <div class="local-points">{d.localPoints.map(([title,text])=><article><h3>{title}</h3><p>{text}</p></article>)}</div>
    </section>
    <section id="free" class="free-section section"><div class="container free-grid">
      <div><p class="eyebrow">{d.freeLabel}</p><h2>{d.freeTitle}</h2><p class="free-text">{d.freeText}</p><div class="download-action"><a class="button" href="#downloads" aria-label={d.chooseDownload} data-download-label={JSON.stringify({download:d.download,downloadCompactVersion:d.downloadCompactVersion,downloadFormatFor:d.downloadFormatFor,choose:d.chooseDownload,chooseCompact:d.chooseCompact,chooseFor:d.chooseDownloadFor})}><span data-download-text>{d.chooseDownload}</span><span aria-hidden="true">↓</span></a><a class="all-releases" href={RELEASES} {...external}>{d.allReleases}<span aria-hidden="true">↗</span></a></div></div>
      <aside id="support"><span class="free-mark" aria-hidden="true">0<span> / ∞</span></span><p class="free-note">{d.freeNote}</p><h3>{d.supportTitle}</h3><p class="support-text">{d.supportText}</p><a class="text-link support-link" href={about+'#support'} {...external}>{d.supportTitle}<span aria-hidden="true">↗</span></a></aside>
    </div></section>
    <section id="downloads" class="section download-section"><div class="container">
      <div class="section-head"><h2>{d.downloads}</h2><p>{d.downloadsText}</p><p class="platform-note">{d.platforms}</p></div>
      <div class="download-box" data-downloads data-labels={JSON.stringify({loading:d.loading,unavailable:d.unavailable,empty:d.empty,noMatch:d.noMatch,version:d.version,download:d.download,downloadVersion:d.downloadCompactVersion,checksum:d.checksum,desktopMode:d.desktopMode})}>
        <div class="download-fallback"><p>{d.fallback}</p><div class="download-links"><a class="button" href={RELEASES} {...external}>{d.releaseLink}<span aria-hidden="true">↗</span></a><a class="text-link" href={REPO+'/actions/workflows/ci.yml'} {...external}>{d.buildsLink}<span aria-hidden="true">↗</span></a></div></div>
        <p data-release-status role="status" hidden></p>
        <div data-download-controls class="download-controls" hidden>
          <label>{d.os}<select name="os"><option value="">{d.allOS}</option><option value="linux">Linux</option><option value="windows">Windows</option><option value="darwin">macOS</option></select></label>
          <label>{d.arch}<select name="arch"><option value="">{d.allArch}</option><option value="amd64">x86-64 (Intel / AMD)</option><option value="arm64">ARM64 / Apple Silicon</option></select></label>
        </div><div data-packages class="packages" hidden></div>
      </div>
      <ol class="install-steps">{d.installSteps.map(step=><li>{step}</li>)}</ol>
      <div class="requirements">
        <h3>{d.requirements}</h3>
        <p>{d.linuxRequirements}</p>
        <dl class="linux-compatibility">
          <div><dt>{d.linuxPackagesTitle}</dt><dd>{d.linuxPackagesText}</dd></div>
          <div><dt>{d.linuxArchiveTitle}</dt><dd>{d.linuxArchiveText}</dd></div>
        </dl>
        <p class="compatibility-scope">{d.linuxVerification}</p>
        <p>{d.requirementsText}</p><p>{d.signing}</p>
      </div>
    </div></section>
    <section class="container section faq-section"><h2>{d.faqTitle}</h2><div class="faq">{d.faqs.map(([q,a])=><article><h3>{q}</h3><p>{a}</p></article>)}</div></section>
  </main>
  <dialog class="image-preview" aria-label={d.fullImage}>
    <button type="button" class="image-preview-close" aria-label={d.closeImage} autofocus><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
    <img alt="" width="1440" height="900" />
  </dialog>
  <footer class="container footer"><div><a class="brand" href="#main"><img src={base+'icon.svg'} width="28" height="28" alt="" /><span>SPK <strong>Ocular</strong></span></a><p>{d.footer}</p></div><nav aria-label={d.projectLinks}><a href={REPO} {...external}>{d.source}</a><a href="#support">{d.supportTitle}</a><a href={REPO+'/issues'} {...external}>{d.issues}</a><a href={REPO+'/blob/master/LICENSE'} {...external}>{d.license}</a><a class="author-link" href={about} {...external}>{d.aboutAuthor}</a></nav></footer>
</Base>

---
import Base from '../layouts/Base.astro';
import ThemeIcon from '../assets/theme.svg';
import { copy } from '../i18n/copy';
import { REPO, RELEASES } from '../lib/releases.mjs';
interface Props { lang: 'ru' | 'en'; }
const { lang } = Astro.props;
const d = copy(lang);
const base = '/spk-ocular/';
const docs = REPO + '/blob/master/docs/usage.md';
const shots = ['resources', 'problems', 'connect'];
---
<Base lang={lang} title={d.title} description={d.description}>
  <a href="#main" class="skip">{d.skip}</a>
  <header class="header">
    <div class="container header-inner">
      <a class="brand" href={base + (lang === 'en' ? 'en/' : '')} aria-label="SPK Ocular">
        <img src={base + 'icon.svg'} width="32" height="32" alt="" />
        <span>SPK <strong>Ocular</strong></span>
      </a>
      <nav aria-label={d.menu} class="desktop-nav">
        {['features','interface','downloads'].map((id,i) => <a href={'#' + id}>{d.nav[i]}</a>)}
        <a href={docs}>{d.docs}</a>
      </nav>
      <div class="header-actions">
        <a class="language" href={base + (lang === 'ru' ? 'en/' : '')} lang={lang === 'ru' ? 'en' : 'ru'} aria-label={lang === 'ru' ? 'English' : 'Русский'}>{lang === 'ru' ? 'EN' : 'RU'}</a>
        <button type="button" class="theme-toggle" aria-label={d.theme} title={d.theme} hidden><ThemeIcon width="20" height="20" aria-hidden="true" /></button>
        <a class="button compact" href="#downloads">{d.download}</a>
      </div>
    </div>
  </header>
  <main id="main">
    <section class="hero container">
      <div class="hero-copy">
        <h1>{d.hero[0]}<span>{d.hero[1]}</span></h1>
        <p class="lead">{d.lead}</p>
        <div class="hero-actions">
          <a class="button" href="#downloads">{d.download}<span aria-hidden="true">↓</span></a>
          <a class="text-link" href="#interface">{d.explore}<span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <a class="hero-visual" href="#interface" aria-label={d.explore}>
        <img src={base + 'media/resources.webp'} width="1440" height="960" alt={d.shot} fetchpriority="high" decoding="async" />
      </a>
    </section>
    <div class="container facts">
      {d.facts.map(([title,text]) => <div><strong>{title}</strong><span>{text}</span></div>)}
    </div>
    <section id="features" class="container section">
      <div class="section-head"><h2>{d.overview}</h2><p>{d.overviewText}</p></div>
      <div class="feature-grid">
        <article class="feature feature-wide"><div><h3>{d.features[0][0]}</h3><p>{d.features[0][1]}</p></div><img src={base + 'media/problems.webp'} alt={d.galleryAlts[1]} width="1440" height="960" loading="lazy" decoding="async" /></article>
        <article class="feature feature-accent"><span class="feature-symbol" aria-hidden="true">↗</span><h3>{d.features[3][0]}</h3><p>{d.features[3][1]}</p><img src={base + 'icon.svg'} alt="" width="96" height="96" loading="lazy" /></article>
        <article class="feature feature-logs"><h3>{d.features[1][0]}</h3><p>{d.features[1][1]}</p><img src={base + 'media/resources.webp'} alt={d.galleryAlts[0]} width="1440" height="960" loading="lazy" decoding="async" /></article>
        <article class="feature feature-review"><span class="feature-symbol" aria-hidden="true">✓</span><h3>{d.features[2][0]}</h3><p>{d.features[2][1]}</p></article>
      </div>
      <div class="tool-pair">{[4,5].map(i=><article><h3>{d.features[i][0]}</h3><p>{d.features[i][1]}</p></article>)}</div>
    </section>
    <section id="interface" class="section gallery-section">
      <div class="container">
        <div class="section-head"><h2>{d.gallery}</h2><p>{d.galleryText}</p></div>
        <div class="gallery-tabs" role="tablist" aria-label={d.nav[1]} hidden>
          {d.galleryTabs.map((title,i)=><button type="button" role="tab" id={'tab-'+i} aria-controls={'shot-'+i} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}>{title}</button>)}
        </div>
        <div class="gallery">
          {shots.map((shot,i)=><figure id={'shot-'+i} class="gallery-panel" data-gallery-panel>
            <img src={base + 'media/' + shot + '.webp'} width="1440" height="960" alt={d.galleryAlts[i]} loading="lazy" decoding="async" />
            <figcaption>{d.galleryTabs[i]}. {d.demo}</figcaption>
          </figure>)}
        </div>
      </div>
    </section>
    <section class="container section local-section">
      <div class="local-intro"><img src={base+'icon.svg'} width="64" height="64" alt="" loading="lazy" /><h2>{d.localTitle}</h2><p>{d.localText}</p><a class="text-link" href={REPO}>{d.source}<span aria-hidden="true">↗</span></a></div>
      <div class="local-points">{d.localPoints.map(([title,text])=><article><h3>{title}</h3><p>{text}</p></article>)}</div>
    </section>
    <section class="container section start-section">
      <h2>{d.start}</h2>
      <ol class="steps">{d.steps.map(([title,text])=><li><h3>{title}</h3><p>{text}</p></li>)}</ol>
    </section>
    <section id="downloads" class="section download-section">
      <div class="container">
        <div class="section-head"><h2>{d.downloads}</h2><p>{d.downloadsText}</p></div>
        <div class="download-box" data-downloads data-labels={JSON.stringify({loading:d.loading,unavailable:d.unavailable,empty:d.empty,noMatch:d.noMatch,version:d.version,download:d.download,checksum:d.checksum})}>
          <div class="download-fallback"><p>{d.fallback}</p><div class="download-links"><a class="button" href={RELEASES}>{d.releaseLink}<span aria-hidden="true">↗</span></a><a class="text-link" href={REPO+'/actions/workflows/ci.yml'}>{d.buildsLink}<span aria-hidden="true">↗</span></a></div></div>
          <p data-release-status role="status" hidden></p>
          <div data-download-controls class="download-controls" hidden>
            <label>{d.os}<select name="os"><option value="">{d.allOS}</option><option value="linux">Linux</option><option value="windows">Windows</option><option value="darwin">macOS</option></select></label>
            <label>{d.arch}<select name="arch"><option value="">{d.allArch}</option><option value="amd64">x86-64 (Intel / AMD)</option><option value="arm64">ARM64 / Apple Silicon</option></select></label>
          </div>
          <div data-packages class="packages" hidden></div>
        </div>
        <details class="requirements"><summary>{d.requirements}</summary><p>{d.requirementsText}</p></details>
      </div>
    </section>
    <section class="container section faq-section"><h2>{d.faqTitle}</h2><div class="faq">{d.faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></section>
  </main>
  <footer class="container footer"><div><a class="brand" href="#main"><img src={base+'icon.svg'} width="28" height="28" alt="" /><span>SPK <strong>Ocular</strong></span></a><p>{d.footer}</p></div><nav aria-label={lang==='ru'?'Ссылки проекта':'Project links'}><a href={REPO}>{d.source}</a><a href={docs}>{d.docs}</a><a href={REPO+'/issues'}>{d.issues}</a><a href={REPO+'/blob/master/LICENSE'}>{d.license}</a></nav></footer>
</Base>

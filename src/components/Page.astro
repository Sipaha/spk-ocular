---
import Base from '../layouts/Base.astro';
import ThemeIcon from '../assets/theme.svg';
import { copy } from '../i18n/copy';
import { REPO, RELEASES } from '../lib/releases.mjs';
interface Props { lang: 'ru' | 'en'; }
const { lang } = Astro.props;
const d = copy(lang);
const base = '/spk-ocular/';
const docs = REPO + '/blob/master/docs/usage.md';
const agentDocs = REPO + '/blob/master/docs/agent-api.md';
const shots = ['workloads', 'logs', 'helm', 'docker'];
const shotURL = (name: string) => `${base}media/${name}-${lang}.webp`;
const navIDs = ['features', 'interface', 'free'];
---
<Base lang={lang} title={d.title} description={d.description}>
  <a href="#main" class="skip">{d.skip}</a>
  <header class="header">
    <div class="container header-inner">
      <a class="brand" href={base + (lang === 'en' ? 'en/' : '')} aria-label="SPK Ocular">
        <img src={base + 'icon.svg'} width="32" height="32" alt="" />
        <span>SPK <strong>Ocular</strong></span>
      </a>
      <nav aria-label={d.menu} class="desktop-nav">
        {navIDs.map((id,i) => <a href={'#' + id}>{d.nav[i]}</a>)}
        <a href={docs}>{d.docs}</a>
      </nav>
      <div class="header-actions">
        <a class="language" href={base + (lang === 'ru' ? 'en/' : '')} lang={lang === 'ru' ? 'en' : 'ru'} aria-label={lang === 'ru' ? 'English' : 'Русский'}>{lang === 'ru' ? 'EN' : 'RU'}</a>
        <button type="button" class="theme-toggle" aria-label={d.theme} title={d.theme} hidden><ThemeIcon width="20" height="20" aria-hidden="true" /></button>
        <a class="button compact" href="#downloads">{d.download}<span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <nav class="mobile-nav container" aria-label={d.menu}>
      {navIDs.map((id,i) => <a href={'#' + id}>{d.nav[i]}</a>)}
    </nav>
  </header>
  <main id="main">
    <section class="hero container">
      <p class="eyebrow">{d.eyebrow}</p>
      <div class="hero-heading">
        <h1>{d.hero[0]}<span>{d.hero[1]}</span></h1>
        <div class="hero-side"><p class="lead">{d.lead}</p><div class="hero-actions"><a class="button" href="#downloads">{d.download}<span aria-hidden="true">↓</span></a><a class="text-link" href="#interface">{d.explore}<span aria-hidden="true">↗</span></a></div></div>
      </div>
      <div class="hero-meta"><a href="#free">{d.freeShort}<span aria-hidden="true">↗</span></a><span>{d.platforms}</span></div>
      <figure class="hero-visual">
        <div class="visual-caption"><span><span class="status-dot" aria-hidden="true"></span>SPK Ocular</span><span>{d.heroCaption}</span></div>
        <a href={shotURL('logs')} aria-label={d.fullImage}><img src={shotURL('logs')} width="1440" height="900" alt={d.galleryAlts[1]} fetchpriority="high" decoding="async" /></a>
        <figcaption>{d.demo}</figcaption>
      </figure>
    </section>
    <div class="container facts">{d.facts.map(([title,text]) => <div><strong>{title}</strong><span>{text}</span></div>)}</div>
    <section id="features" class="container section">
      <div class="section-head"><h2>{d.overview}</h2><p>{d.overviewText}</p></div>
      <div class="workflows">
        {d.workflows.map((flow,i)=><article class:list={['workflow', {reverse:i===1}]} id={flow.image}>
          <div class="workflow-copy"><p class="eyebrow">{flow.label}</p><h3>{flow.title}</h3><p>{flow.text}</p><ul>{flow.points.map(point=><li>{point}</li>)}</ul><a class="text-link" href={docs+(flow.image==='helm'?'#helm':'')}>{flow.link}<span aria-hidden="true">↗</span></a></div>
          <figure class="workflow-image"><a href={shotURL(flow.image)} aria-label={d.fullImage}><img src={shotURL(flow.image)} width="1440" height="900" alt={flow.alt} loading="lazy" decoding="async" /></a><figcaption>{flow.image==='helm'?d.syntheticDemo:d.demo}</figcaption></figure>
        </article>)}
      </div>
      <div class="tool-section"><h3>{d.toolsTitle}</h3><div class="tool-grid">{d.tools.map(([title,text],i)=><article><span class="tool-index" aria-hidden="true">0{i+1}</span><div><h4>{title}</h4><p>{text}</p></div></article>)}</div></div>
    </section>
    <section class="agent-section section" id="agents"><div class="container agent-grid">
      <div><p class="eyebrow">{d.agentLabel}</p><h2>{d.agentTitle}</h2><p class="agent-lead">{d.agentText}</p><a class="text-link" href={agentDocs}>{d.agentDocs}<span aria-hidden="true">↗</span></a></div>
      <div><ol class="agent-steps">{d.agentSteps.map(([title,text])=><li><h3>{title}</h3><p>{text}</p></li>)}</ol><p class="agent-boundary">{d.agentBoundary}</p></div>
    </div></section>
    <section id="interface" class="section gallery-section"><div class="container">
      <div class="section-head"><h2>{d.gallery}</h2><p>{d.galleryText}</p></div>
      <div class="gallery-tabs" role="tablist" aria-label={d.nav[1]} hidden>{d.galleryTabs.map((title,i)=><button type="button" role="tab" id={'tab-'+i} aria-controls={'shot-'+i} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}>{title}</button>)}</div>
      <div class="gallery">{shots.map((shot,i)=><figure id={'shot-'+i} class="gallery-panel" data-gallery-panel>
        <a href={shotURL(shot)} aria-label={d.fullImage}><img src={shotURL(shot)} width="1440" height="900" alt={d.galleryAlts[i]} loading="lazy" decoding="async" /></a>
        <figcaption><span>{d.galleryTabs[i]} · {shot==='helm'?d.syntheticDemo:d.demo}</span><a href={shotURL(shot)}>{d.fullImage} ↗</a></figcaption>
      </figure>)}</div>
    </div></section>
    <section class="container section local-section">
      <div><p class="eyebrow">LOCAL / OPEN SOURCE</p><h2>{d.localTitle}</h2><p>{d.localText}</p><a class="text-link" href={REPO}>{d.source}<span aria-hidden="true">↗</span></a></div>
      <div class="local-points">{d.localPoints.map(([title,text])=><article><h3>{title}</h3><p>{text}</p></article>)}</div>
    </section>
    <section id="free" class="free-section section"><div class="container free-grid">
      <div><p class="eyebrow">{d.freeLabel}</p><h2>{d.freeTitle}</h2><p class="free-text">{d.freeText}</p><a class="button" href="#downloads">{d.download}<span aria-hidden="true">↓</span></a></div>
      <aside id="support"><span class="free-mark" aria-hidden="true">0<span> / ∞</span></span><p class="free-note">{d.freeNote}</p><h3>{d.supportTitle}</h3><p>{d.supportText}</p></aside>
    </div></section>
    <section id="downloads" class="section download-section"><div class="container">
      <div class="section-head"><h2>{d.downloads}</h2><p>{d.downloadsText}</p><p class="platform-note">{d.platforms}</p></div>
      <div class="download-box" data-downloads data-labels={JSON.stringify({loading:d.loading,unavailable:d.unavailable,empty:d.empty,noMatch:d.noMatch,version:d.version,download:d.download,checksum:d.checksum,desktopMode:d.desktopMode,browserMode:d.browserMode})}>
        <div class="download-fallback"><p>{d.fallback}</p><div class="download-links"><a class="button" href={RELEASES}>{d.releaseLink}<span aria-hidden="true">↗</span></a><a class="text-link" href={REPO+'/actions/workflows/ci.yml'}>{d.buildsLink}<span aria-hidden="true">↗</span></a></div></div>
        <p data-release-status role="status" hidden></p>
        <div data-download-controls class="download-controls" hidden>
          <label>{d.os}<select name="os"><option value="">{d.allOS}</option><option value="linux">Linux</option><option value="windows">Windows</option><option value="darwin">macOS</option></select></label>
          <label>{d.arch}<select name="arch"><option value="">{d.allArch}</option><option value="amd64">x86-64 (Intel / AMD)</option><option value="arm64">ARM64 / Apple Silicon</option></select></label>
        </div><div data-packages class="packages" hidden></div>
      </div>
      <div class="requirements"><h3>{d.requirements}</h3><p>{d.requirementsText}</p><p>{d.signing}</p><a class="text-link" href={REPO+'/blob/master/README.md'}>{d.installDocs} ↗</a></div>
    </div></section>
    <section class="container section faq-section"><h2>{d.faqTitle}</h2><div class="faq">{d.faqs.map(([q,a])=><article><h3>{q}</h3><p>{a}</p></article>)}</div></section>
  </main>
  <footer class="container footer"><div><a class="brand" href="#main"><img src={base+'icon.svg'} width="28" height="28" alt="" /><span>SPK <strong>Ocular</strong></span></a><p>{d.footer}</p></div><nav aria-label={lang==='ru'?'Ссылки проекта':'Project links'}><a href={REPO}>{d.source}</a><a href={docs}>{d.docs}</a><a href="#support">{d.supportTitle}</a><a href={REPO+'/issues'}>{d.issues}</a><a href={REPO+'/blob/master/LICENSE'}>{d.license}</a></nav></footer>
</Base>

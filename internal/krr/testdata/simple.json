{
  "resources": [
    "cpu",
    "memory"
  ],
  "strategy": {
    "name": "simple",
    "settings": {
      "cpu_percentile": 95,
      "memory_buffer_percentage": 15,
      "points_required": 100,
      "allow_hpa": false,
      "use_oomkill_data": false,
      "oom_memory_buffer_percentage": 25,
      "history_duration": 336,
      "timeframe_duration": 1.25
    }
  },
  "errors": [
    {
      "credential": "PRIVATE-ERROR"
    }
  ],
  "config": {
    "prometheus_url": "PRIVATE-URL",
    "eks_access_key": "PRIVATE-KEY"
  },
  "description": "PRIVATE-DESCRIPTION",
  "scans": [
    {
      "object": {
        "cluster": "context-a",
        "kind": "Deployment",
        "namespace": "blue",
        "name": "app",
        "container": "main",
        "hpa": null,
        "warnings": [],
        "allocations": {
          "requests": {
            "cpu": 0.5,
            "memory": 104857600
          },
          "limits": {
            "cpu": null,
            "memory": 209715200
          }
        },
        "labels": {
          "secret": "PRIVATE-LABEL"
        },
        "annotations": {
          "value": "PRIVATE-ANNOTATION"
        },
        "pods": [
          {
            "name": "PRIVATE-POD"
          }
        ]
      },
      "recommended": {
        "requests": {
          "cpu": {
            "value": 0.125,
            "severity": "WARNING"
          },
          "memory": {
            "value": "?",
            "severity": "UNKNOWN"
          }
        },
        "limits": {
          "cpu": {
            "value": null,
            "severity": "GOOD"
          },
          "memory": {
            "value": 100000000,
            "severity": "OK"
          }
        },
        "info": {
          "cpu": null,
          "memory": "Not enough data"
        }
      },
      "severity": "WARNING"
    }
  ]
}
